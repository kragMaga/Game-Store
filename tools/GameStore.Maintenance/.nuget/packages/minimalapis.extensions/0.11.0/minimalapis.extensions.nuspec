<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MinimalApis.Extensions</id>
    <version>0.11.0</version>
    <authors>Damian Edwards</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/DamianEdwards/MinimalApis.Extensions</projectUrl>
    <description>A set of extensions and helpers for working with ASP.NET Core Minimal APIs.</description>
    <copyright>Copyright © Damian Edwards</copyright>
    <tags>ASP.NET Web MinimalApis Apis REST Binding IResult</tags>
    <repository type="git" url="https://github.com/DamianEdwards/MinimalApis.Extensions" commit="f1a6ab59edadd7625d12770adbede0569ed90244" />
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="MiniValidation" version="0.8.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net7.0">
        <dependency id="Microsoft.OpenApi" version="1.4.3" exclude="Build,Analyzers" />
        <dependency id="MiniValidation" version="0.8.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net6.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
      <group targetFramework="net7.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
  </metadata>
</package>
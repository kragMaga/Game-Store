{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PasswordScreening": {
    "CheckCompromisedPasswords": true,
    "BlockedPasswords": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "RateLimits": {
    "BaselinePermits": 10,
    "BaselineWindowSeconds": 300,
    "PasswordPermits": 5,
    "PasswordWindowSeconds": 300,
    "RecoveryPermits": 3,
    "RecoveryWindowSeconds": 900,
    "InventoryWritePermits": 120,
    "InventoryWriteWindowSeconds": 60
  },
  "Deployment": {
    "MultipleInstances": false,
    "SharedRateLimitingEnforced": false
  },
  "ConnectionStrings": {
    "TradeNest": "Data Source=GameStore.db"
  },
  "Jwt": {
    "Issuer": "GameStore.Api",
    "Audience": "GameStore.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenIdleMinutes": 30,
    "MaxSessionDays": 7
  },
  "LowStock": {
    "Enabled": true
  }
}
